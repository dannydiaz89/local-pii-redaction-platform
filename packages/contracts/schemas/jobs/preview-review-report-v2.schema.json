{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-pii.dev/schemas/jobs/preview-review-report/2.0.0",
  "title": "Ephemeral preview review report v2",
  "description": "A bounded, value-free detection and conflict list from an authenticated process-local browser preview scan.",
  "schemaVersion": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "operation", "outcome", "counts", "detections", "detailsLimited",
    "conflicts", "conflictDetailsLimited"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "operation": { "const": "SCAN" },
    "outcome": { "enum": ["SUCCEEDED", "NEEDS_REVIEW"] },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detections", "conflicts", "byEntity"],
      "properties": {
        "detections": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "conflicts": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "byEntity": {
          "type": "object",
          "maxProperties": 24,
          "propertyNames": { "$ref": "https://local-pii.dev/schemas/common/entity-type/1.0.0" },
          "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 10000 }
        }
      }
    },
    "detections": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entityType", "start", "end", "offsetUnit", "confidence", "sources"],
        "properties": {
          "entityType": { "$ref": "https://local-pii.dev/schemas/common/entity-type/1.0.0" },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 1 },
          "offsetUnit": { "const": "UNICODE_CODE_POINT" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true,
            "items": { "enum": ["REGEX", "CHECKSUM", "STRUCTURED", "DICTIONARY", "MODEL", "MANUAL"] }
          }
        }
      }
    },
    "detailsLimited": { "type": "boolean" },
    "conflicts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "start", "end", "offsetUnit", "entityTypes", "sources"],
        "properties": {
          "code": { "const": "INCOMPATIBLE_OVERLAP" },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 1 },
          "offsetUnit": { "const": "UNICODE_CODE_POINT" },
          "entityTypes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "uniqueItems": true,
            "items": { "$ref": "https://local-pii.dev/schemas/common/entity-type/1.0.0" }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true,
            "items": { "enum": ["REGEX", "CHECKSUM", "STRUCTURED", "DICTIONARY", "MODEL", "MANUAL"] }
          }
        }
      }
    },
    "conflictDetailsLimited": { "type": "boolean" }
  },
  "examples": [{
    "schemaVersion": "2.0.0",
    "operation": "SCAN",
    "outcome": "NEEDS_REVIEW",
    "counts": { "detections": 1, "conflicts": 1, "byEntity": { "EMAIL": 1 } },
    "detections": [{
      "entityType": "EMAIL", "start": 8, "end": 25, "offsetUnit": "UNICODE_CODE_POINT",
      "confidence": 0.99, "sources": ["REGEX"]
    }],
    "detailsLimited": false,
    "conflicts": [{
      "code": "INCOMPATIBLE_OVERLAP", "start": 8, "end": 25,
      "offsetUnit": "UNICODE_CODE_POINT", "entityTypes": ["EMAIL", "USERNAME"],
      "sources": ["REGEX", "MODEL"]
    }],
    "conflictDetailsLimited": false
  }]
}
