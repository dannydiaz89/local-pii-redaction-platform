{
  "name": "local-pii",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "author": "dannydiaz89 (https://github.com/dannydiaz89)",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "adr:check": "node --import tsx tooling/check-adr-controls.ts",
    "build": "pnpm -r --if-present build",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm python:check && pnpm contracts:check && pnpm sdk:api:check && pnpm fixtures:check && pnpm taxonomy:check && pnpm adr:check && pnpm policy:profiles:check && pnpm privacy:check && pnpm ephemeral:check",
    "contracts:check": "node --import tsx tooling/check-schema-governance.ts && node --import tsx tooling/check-contract-corpus.ts && .venv/bin/python services/inference-python/scripts/check_contracts.py && node --import tsx tooling/check-domain-contract-drift.ts && node --import tsx tooling/check-generated.ts",
    "ephemeral:check": "pnpm build && node --import tsx tooling/check-ephemeral-profile-gate.ts",
    "ephemeral:filesystem-failure:check": "pnpm build && node --import tsx tooling/check-linux-filesystem-failure-gate.ts",
    "ephemeral:resource:check": "pnpm build && node --import tsx tooling/check-linux-resource-profile-gate.ts",
    "ephemeral:syscall:check": "pnpm build && node --import tsx tooling/check-linux-syscall-gate.ts",
    "eval:ollama": "node --import tsx tooling/evaluate-ollama.ts",
    "fixtures:check": "node --import tsx tooling/generate-synthetic-fixtures.ts",
    "fixtures:generate": "node --import tsx tooling/generate-synthetic-fixtures.ts --write",
    "generate": "node --import tsx tooling/generate-typescript.ts && .venv/bin/python services/inference-python/scripts/generate_models.py",
    "lint": "eslint . && node --import tsx tooling/check-boundaries.ts",
    "perf:csv-scale:check": "pnpm build && node --import tsx tooling/check-csv-scale-benchmark.ts",
    "pii-redact": "node apps/cli/dist/index.js",
    "policy:profiles:check": "node --import tsx tooling/check-policy-profiles.ts",
    "privacy:check": "node --import tsx tooling/check-privacy-canaries.ts",
    "privacy:scan": "node --import tsx tooling/check-privacy-canaries.ts",
    "python:check": ".venv/bin/ruff check services/inference-python && .venv/bin/pytest",
    "sdk:api:check": "node --import tsx tooling/check-sdk-public-api.ts",
    "start:local": "pnpm build && node apps/api/dist/main.js",
    "taxonomy:check": "node --import tsx tooling/check-test-taxonomy.ts",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@hono/node-server": "^2.1.0",
    "@local-pii/policy": "workspace:*",
    "@local-pii/profile-local": "workspace:*",
    "@local-pii/provider-ollama": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "ajv": "^8.17.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.32.0",
    "fastify": "^5.12.1",
    "hono": "^4.13.5",
    "jsdom": "^30.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@>=3.0.0 <3.1.6": "3.1.6",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "fast-uri@>=4.0.0 <4.1.3": "4.1.3"
    }
  }
}
